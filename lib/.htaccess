# Esta pasta nunca é acessada pela web (é incluída pelo PHP, não requisitada).
# Se a hospedagem não deixar apontar o domínio para public/, este arquivo
# impede o acesso direto a lib/dados.php.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
